-- Plot data cache
local plotData = {}
local plotListeners = {}
local animalListReference = nil
local animalRegistry = {}
local promptReferences = {}
local isRemoteHooked = false

local function parseAnimalIdentifier(str)
	local parts = {}
	for token in string.gmatch(tostring(str), "[^%.]+") do
		table.insert(parts, tonumber(token) or token)
	end
	return parts
end

local function applyRemoteUpdate(plotName, eventData)
	local plot = plotData[plotName]
	if type(plot) ~= "table" then return end

	local eventType = eventData[2]
	local value = eventData[3]
	local key = eventData[4]
	local parent = nil
	local finalKey = nil
	local cursor = plot

	for _, part in ipairs(parseAnimalIdentifier(eventData[1])) do
		if cursor and cursor[part] then
			parent = cursor
			finalKey = part
			cursor = cursor[part]
		else
			parent = cursor
			finalKey = part
			cursor = nil
		end
	end

	if eventType == "Changed" then
		if parent then parent[finalKey] = value end
	elseif eventType == "ListInserted" then
		if cursor then table.insert(cursor, key, value) end
	elseif eventType == "ListRemoved" then
		if cursor then table.remove(cursor, key) end
	elseif eventType == "DictionaryInserted" then
		if cursor then cursor[key] = value end
	elseif eventType == "DictionaryRemoved" then
		if cursor then cursor[key] = nil end
	end
end

-- Hook the Synchronizer channel for a plot
local function hookPlot(plotModel)
	if plotListeners[plotModel] then return end

	local plotName = tostring(plotModel.Name)
	local plotsFolder = workspace:FindFirstChild("Plots")
	if not plotsFolder or not plotsFolder:FindFirstChild(plotName) then return end

	if plotData[plotName] == nil then
		local syncChannel = plotModel
		-- We look up the channel via Synchronizer
		local synchronizer = ReplicatedStorage
			:FindFirstChild("Packages")
			and ReplicatedStorage.Packages:FindFirstChild("Synchronizer")
		local channel = synchronizer and synchronizer:FindFirstChild("Channel")
		local remote = channel and channel:FindFirstChild(plotName)

		if remote then
			local ok, result = pcall(function()
				return remote:InvokeServer(plotName)
			end)
			plotData[plotName] = (ok and type(result) == "table") and result or {}
		else
			plotData[plotName] = {}
		end
	end

	plotListeners[plotModel] = plotModel.OnClientEvent:Connect(function(payload)
		for _, entry in ipairs(payload) do
			applyRemoteUpdate(plotName, entry)
		end
	end)
end

-- Read the owner display name from a plot sign
local function getPlotOwner(plotModel)
	local plotSign = plotModel:FindFirstChild("PlotSign")
	local frame = plotSign
		and plotSign:FindFirstChild("SurfaceGui")
		and plotSign.SurfaceGui:FindFirstChild("Frame")
	frame = frame and frame:FindFirstChild("TextLabel")
	if not frame or frame.Text == "Empty Base" then return nil end
	return frame.Text:gsub("'s [Bb]ase$", ""):gsub("%s+$", "")
end

local function isMyPlot(entry)
	local plotsFolder = workspace:FindFirstChild("Plots")
	if not plotsFolder then return false end
	local plotModel = plotsFolder:FindFirstChild(entry.plot)
	if not plotModel then return false end
	return getPlotOwner(plotModel) == LocalPlayer.DisplayName
end

local function getPromptPosition(entry)
	local plotsFolder = workspace:FindFirstChild("Plots")
	if not plotsFolder then return nil end
	local plotModel = plotsFolder:FindFirstChild(entry.plot)
	if not plotModel then return nil end

	local podiums = plotModel:FindFirstChild("AnimalPodiums")
	if not podiums then return nil end
	local slot = podiums:FindFirstChild(entry.slot)
	if not slot then return nil end
	return slot:GetPivot().Position
end

-- Collect all stealable animals on other people's plots
local function refreshAnimalRegistry()
	local plotsFolder = workspace:FindFirstChild("Plots")
	if not plotsFolder then return end

	local entries = {}
	for _, plotModel in ipairs(plotsFolder:GetChildren()) do
		local cached = plotData[plotModel.Name]
		local list = cached and cached.AnimalList

		if type(list) == "table" then
			for slotIndex, animal in pairs(list) do
				if type(animal) == "table" then
					if animalRegistry and animalRegistry[animal.Index] then
						table.insert(entries, {
							plot = plotModel.Name,
							slot = tostring(slotIndex),
							uid = plotModel.Name .. "_" .. tostring(slotIndex),
						})
					end
				end
			end
		end
	end

	promptReferences = entries
end

-- Hook the synchronizer remotes
local function setupSynchronizerHooks()
	if isRemoteHooked then return end
	isRemoteHooked = true

	pcall(function()
		local packages = ReplicatedStorage:WaitForChild("Packages", 10)
		local datas = ReplicatedStorage:WaitForChild("Datas", 10)
		local plots = workspace:WaitForChild("Plots", 10)

		local ok, result = pcall(require, datas:WaitForChild("Animals", 10))
		if not ok then
			isRemoteHooked = false
			return
		end
		animalRegistry = result

		local synchronizer = packages:WaitForChild("Synchronizer", 10)
		local channel = synchronizer:WaitForChild("Channel", 10)
		local plotRemote = synchronizer:FindFirstChild("PlotRemote")

		local function attach(child)
			if plotListeners[child] then return end
			local name = tostring(child.Name)
			if not plots:FindFirstChild(name) then return end

			if plotData[name] == nil then
				if plotRemote then
					local ok2, res = pcall(function()
						return plotRemote:InvokeServer(name)
					end)
					plotData[name] = (ok2 and type(res) == "table") and res or {}
				else
					plotData[name] = {}
				end
			end

			plotListeners[child] = child.OnClientEvent:Connect(function(payload)
				for _, entry in ipairs(payload) do
					applyRemoteUpdate(name, entry)
				end
			end)
		end

		for _, child in ipairs(channel:GetChildren()) do
			if child:IsA("RemoteEvent") then
				attach(child)
			end
		end

		channel.ChildAdded:Connect(function(child)
			if child:IsA("RemoteEvent") then
				attach(child)
			end
		end)
	end)
end

-- Find closest prompt to steal
local function findClosestPrompt()
	local root = getCharacterRoot()
	if not root then return nil end

	local closest = nil
	local closestDistance = math.huge

	for _, entry in ipairs(promptReferences) do
		if not isMyPlot(entry) then
			local pos = getPromptPosition(entry)
			if pos then
				local dist = (pos - root.Position).Magnitude
				if dist < closestDistance and dist <= Constants.STEAL_RADIUS then
					local cached = promptReferences[entry.uid]
					if cached and cached.Parent then
						closestDistance = dist
						closest = cached
					else
						local plotsFolder = workspace:FindFirstChild("Plots")
						local plotModel = plotsFolder and plotsFolder:FindFirstChild(entry.plot)
						local podiums = plotModel and plotModel:FindFirstChild("AnimalPodiums")
						local slot = podiums and podiums:FindFirstChild(entry.slot)
						local base = slot and slot:FindFirstChild("Base")
						local spawn = base and base:FindFirstChild("Spawn")
						local promptAttachment = spawn and spawn:FindFirstChild("PromptAttachment")

						if promptAttachment then
							for _, child in ipairs(promptAttachment:GetChildren()) do
								if child:IsA("ProximityPrompt") then
									promptReferences[entry.uid] = child
									closest = child
									closestDistance = dist
									break
								end
							end
						end
					end
				end
			end
		end
	end

	return closest
end

-- Ragdoll detection
do
	local ragdollCount = 0

	local function bindCharacter(character)
		local humanoid = character:WaitForChild("Humanoid", 5)
		if not humanoid then return end

		if characterConnections then
			for _, conn in ipairs(characterConnections) do
				conn:Disconnect()
			end
			characterConnections = nil
		end

		local lastStateChange = 0

		local function markRagdoll()
			if isRagdolled then return end
			isRagdolled = true
			lastStateChange = tick()
			ragdollCount += 1
			local snapshot = ragdollCount

			if not Config.UseSimpleSteal and not Config.UseSemiLogic then
				if heartbeatConnection then
					heartbeatConnection:Disconnect()
					heartbeatConnection = nil
				end
				isStealing = false
				promptCache = {}
				stealingStartTime = nil
				resetProgressBar()
			end

			task.spawn(function()
				task.wait(0.5)
				if ragdollCount == snapshot then
					isRagdolled = false
				end
			end)
		end

		local function clearRagdoll()
			if tick() - lastStateChange < 1 then return end
			if isRagdolled then
				isRagdolled = false
			end
		end

		local conn1 = humanoid.StateChanged:Connect(function(_, newState)
			if newState == Enum.HumanoidStateType.Physics
				or newState == Enum.HumanoidStateType.Ragdoll
			then
				markRagdoll()
			elseif newState == Enum.HumanoidStateType.GettingUp then
				clearRagdoll()
			end
		end)

		local conn2 = humanoid:GetPropertyChangedSignal("PlatformStand"):Connect(function()
			if humanoid.PlatformStand then
				markRagdoll()
			else
				clearRagdoll()
			end
		end)

		characterConnections = { conn1, conn2 }
	end

	if LocalPlayer.Character then
		bindCharacter(LocalPlayer.Character)
	end

	LocalPlayer.CharacterAdded:Connect(function(character)
		task.wait(1)
		bindCharacter(character)
	end)
end

-- Attempt steal from a prompt
local function beginSteal(prompt)
	if isStealing then return end
	if isRagdolled then return end
	if not prompt or not prompt.Parent then return end

	if not promptCache[prompt] then
		promptCache[prompt] = { hold = {}, trigger = {}, ready = true }

		pcall(function()
			if getconnections then
				for _, conn in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do
					if conn.Function then
						table.insert(promptCache[prompt].hold, conn.Function)
					end
				end
				for _, conn in ipairs(getconnections(prompt.Triggered)) do
					if conn.Function then
						table.insert(promptCache[prompt].trigger, conn.Function)
					end
				end
			end
		end)
	end

	local cache = promptCache[prompt]
	if not cache.ready then return end

	cache.ready = false
	isStealing = true
	stealingStartTime = tick()
	resetProgressBar()

	for _, fn in ipairs(cache.hold) do
		task.spawn(fn)
	end

	if heartbeatConnection then
		heartbeatConnection:Disconnect()
	end

	-- Simple mode
	if Config.UseSimpleSteal then
		heartbeatConnection = RunService.Heartbeat:Connect(function()
			if not isStealing then
				heartbeatConnection:Disconnect()
				return
			end

			local ratio = math.clamp((tick() - stealingStartTime) / Constants.STEAL_DURATION, 0, 1)
			progressFill.Size = UDim2.new(ratio, 0, 1, 0)

			local root = getCharacterRoot()
			if root and prompt and prompt.Parent then
				local parent = prompt.Parent.Parent
				if parent and parent:IsA("BasePart") then
					if (parent.Position - root.Position).Magnitude > Constants.STEAL_RADIUS then
						heartbeatConnection:Disconnect()
						heartbeatConnection = nil
						isStealing = false
						cache.ready = true
						resetProgressBar()
						return
					end
				end
			end

			if ratio >= 1 then
				heartbeatConnection:Disconnect()
				heartbeatConnection = nil
				for _, fn in ipairs(cache.trigger) do
					task.spawn(fn)
				end
				resetProgressBar()
				cache.ready = true
				isStealing = false
			end
		end)
		return
	end

	-- Semi logic
	if Config.UseSemiLogic then
		local holdMin = Config.HoldMin or 1.3
		local holdMax = Config.HoldMax or 2.6
		local entryDelay = Config.EntryDelay or 0.3
		local semiCooldown = Config.SemiCooldown or 0.05
		local continueRadius = Config.ContinueRadius or 10
		local inRangeAtStart = false
		local root = getCharacterRoot()

		if root and prompt and prompt.Parent then
			local parent = prompt.Parent.Parent
			if parent and parent:IsA("BasePart") then
				inRangeAtStart = (parent.Position - root.Position).Magnitude <= continueRadius
			end
		end

		local phase = "holding"
		heartbeatConnection = RunService.Heartbeat:Connect(function()
			if not isStealing then
				heartbeatConnection:Disconnect()
				return
			end

			local elapsed = tick() - stealingStartTime
			progressFill.Size = UDim2.new(math.clamp(elapsed / holdMax, 0, 1), 0, 1, 0)

			local root2 = getCharacterRoot()
			if root2 and prompt and prompt.Parent then
				local parent = prompt.Parent.Parent
				if parent and parent:IsA("BasePart") then
					if (parent.Position - root2.Position).Magnitude > Constants.STEAL_RADIUS then
						heartbeatConnection:Disconnect()
						heartbeatConnection = nil
						isStealing = false
						cache.ready = true
						resetProgressBar()
						return
					end
				end
			end

			if phase == "holding" then
				if elapsed >= holdMin then
					phase = "waitingRange"
				end
			elseif phase == "waitingRange" then
				if elapsed > holdMax then
					heartbeatConnection:Disconnect()
					heartbeatConnection = nil
					isStealing = false
					cache.ready = true
					resetProgressBar()
					return
				end

				local parent = root2 and prompt and prompt.Parent
				local within = false
				if parent then
					local p = prompt.Parent.Parent
					if p and p:IsA("BasePart") then
						within = (p.Position - root2.Position).Magnitude <= continueRadius
					end
				end

				if within then
					heartbeatConnection:Disconnect()
					heartbeatConnection = nil
					task.spawn(function()
						if not inRangeAtStart then
							task.wait(entryDelay)
						end
						for _, fn in ipairs(cache.trigger) do
							task.spawn(fn)
						end
						progressFill.Size = UDim2.new(0, 0, 1, 0)
						task.wait(semiCooldown)
						resetProgressBar()
						cache.ready = true
						isStealing = false
					end)
				end
			end
		end)
		return
	end

	-- Normal mode with pause logic
	local isPaused = false
	local pauseSnapshot = false
	local pauseStart = nil
	local pausedRatio = 0
	local currentPrompt = prompt

	heartbeatConnection = RunService.Heartbeat:Connect(function()
		if not isStealing then
			heartbeatConnection:Disconnect()
			return
		end

		local pauseRatio = Config.PausePercent / 100

		if not isPaused then
			local ratio = math.clamp((tick() - stealingStartTime) / Constants.STEAL_DURATION, 0, 1)
			local root = getCharacterRoot()

			if root and currentPrompt and currentPrompt.Parent then
				local parent = currentPrompt.Parent.Parent
				if parent and parent:IsA("BasePart") then
					if (parent.Position - root.Position).Magnitude > Constants.STEAL_RADIUS then
						heartbeatConnection:Disconnect()
						heartbeatConnection = nil
						isStealing = false
						cache.ready = true
						resetProgressBar()
						return
					end
				end
			end

			if ratio >= pauseRatio and not pauseSnapshot then
				isPaused = true
				pauseSnapshot = true
				pausedRatio = pauseRatio
				pauseStart = tick()
				progressFill.Size = UDim2.new(pauseRatio, 0, 1, 0)
				return
			end

			progressFill.Size = UDim2.new(ratio, 0, 1, 0)

			if ratio >= 1 then
				heartbeatConnection:Disconnect()
				heartbeatConnection = nil
				for _, fn in ipairs(cache.trigger) do
					task.spawn(fn)
				end
				resetProgressBar()
				cache.ready = true
				isStealing = false
			end
		else
			local elapsed = tick() - pauseStart
			local root = getCharacterRoot()

			if root and currentPrompt and currentPrompt.Parent then
				local parent = currentPrompt.Parent.Parent
				if parent and parent:IsA("BasePart") then
					if (parent.Position - root.Position).Magnitude > Constants.STEAL_RADIUS then
						heartbeatConnection:Disconnect()
						heartbeatConnection = nil
						isStealing = false
						cache.ready = true
						resetProgressBar()
						return
					end
				end
			end

			if elapsed >= Config.WaitTimeout then
				isPaused = false
				stealingStartTime = tick() - pausedRatio * Constants.STEAL_DURATION
				return
			end

			local within = false
			if root and currentPrompt and currentPrompt.Parent then
				local parent = currentPrompt.Parent.Parent
				if parent and parent:IsA("BasePart") then
					within = (parent.Position - root.Position).Magnitude <= Config.ContinueRadius
				end
			end

			if within then
				isPaused = false
				stealingStartTime = tick() - pausedRatio * Constants.STEAL_DURATION
			end
		end
	end)
end

-- Main scan loop
local function startScanning()
	if scanConnection then return end

	local lastScan = 0
	scanConnection = RunService.Heartbeat:Connect(function()
		if not Config.AutoStealEnabled or isStealing then return end

		local now = tick()
		if now - lastScan < 0.05 then return end
		lastScan = now

		local prompt = findClosestPrompt()
		if prompt then
			beginSteal(prompt)
		end
	end)
end

local function stopScanning()
	if scanConnection then
		scanConnection:Disconnect()
		scanConnection = nil
	end
	if heartbeatConnection then
		heartbeatConnection:Disconnect()
		heartbeatConnection = nil
	end
	isStealing = false
	resetProgressBar()
end

