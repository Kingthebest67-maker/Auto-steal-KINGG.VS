local function applyMode(mode)
	if mode == "Normal" then
		Config.UseSimpleSteal = true
		Config.UseSemiLogic = false
	elseif mode == "Semi" then
		Config.UseSimpleSteal = false
		Config.UseSemiLogic = true
		Config.HoldMin = 1.3
		Config.HoldMax = 2.6
		Config.EntryDelay = 0.3
		Config.SemiCooldown = 0.05
		Config.ContinueRadius = 10
	elseif mode == "Semi Normal" then
		Config.UseSimpleSteal = false
		Config.UseSemiLogic = false
		Config.WaitTimeout = 1.7
		Config.ContinueRadius = 10
	end
end

local function setMode(mode)
	for i, name in ipairs(modeNames) do
		if name == mode then
			currentModeIndex = i
			break
		end
	end
	applyMode(mode)
	refreshModeButtons()
	pcall(function()
		if writefile then
			writefile("KingAutoSteal_Mode", mode)
		end
	end)
end

